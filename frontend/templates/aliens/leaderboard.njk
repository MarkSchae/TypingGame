

{% block body %}
<div class="container my-5">

    <!-- Leaderboard Section -->
    <h1 class="text-center mb-4">Leaderboard</h1>

    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Rank</th>
                    <th scope="col">Gamertag</th>
                    <th scope="col">Skill Rating</th>
                </tr>
            </thead>
            <tbody>
                {% for instance in sorted_leaderboard %}
                    <tr>
                        <td>{{ instance.rank }}</td>
                        <td>
                            <a href="/aliens/profile/{{ instance.user.id }}/" class="text-decoration-none fw-bold">
                                {{ instance.user.gamertag }}
                            </a>
                        </td>
                        <td>{{ instance.user_skill_rating }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- New Post Section -->
    <div class="mt-5">
        <h2>New Post</h2>
        <form id="new-post-form" class="mb-4">
            <div class="mb-3">
                <label for="post_content-text">Post Content</label>
                <textarea id="post_content-text" name="post_content" rows="4" cols="50" class="form-control"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Post</button>
        </form>
    </div>

    <!-- Posts/Comments Section -->
    <div class="mt-5">
        <h2>Posts / Comments</h2>
        {% if posts.length %}
            <ul class="list-group">
                {% for post in posts %}
                    <li class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-start mb-2 shadow-sm">
                        <div>
                            <strong>
                                <a href="/aliens/profile/{{ post.user.id }}/" class="text-decoration-none">
                                    {{ post.user.gamertag }}
                                </a>
                            </strong>
                            <p class="mb-1">{{ post.content }}</p>
                        </div>
                        <small class="text-muted">{{ post.created_at }}</small>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">No posts yet.</p>
        {% endif %}
    </div>

</div>

<script src="/static/aliens/stats.js"></script>

{% endblock %}

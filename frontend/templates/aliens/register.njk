

{% block body %}

<h2>Register</h2>

{% if message %}
  <div class="alert alert-info">{{ message }}</div>
{% endif %}

<form id="register-form" enctype="multipart/form-data">
    <div class="form-group mb-3">
        <input class="form-control" autofocus type="text" name="username" placeholder="Username" required>
    </div>
    <div class="form-group mb-3">
        <input class="form-control" type="text" name="real_name" placeholder="Name" required>
    </div>
    <div class="form-group mb-3">
        <input class="form-control" type="text" name="country" placeholder="Country" required>
    </div>
    <div class="form-group mb-3">
        <input class="form-control" type="text" name="gamertag" placeholder="Gamertag" required>
    </div>
    <div class="form-group mb-3">
        <input class="form-control" type="email" name="email" placeholder="Email Address" required>
    </div>
    <div class="form-group mb-3">
        <input class="form-control" type="password" name="password" placeholder="Password" required>
    </div>
    <div class="form-group mb-3">
        <input class="form-control" type="password" name="confirmation" placeholder="Confirm Password" required>
    </div>
    <div class="form-group mb-3">
        <input type="file" name="image" accept="image/*" id="register_image">
    </div>
    <input class="btn btn-primary" type="submit" value="Register">
</form>

<p>
    Already have an account? 
    <a href="#" class="nav-link-api" data-endpoint="{{ login_url }}" data-template="login.njk">Log In here</a>
</p>
<script src='/static/aliens/app.js' defer></script>

{% endblock %}
